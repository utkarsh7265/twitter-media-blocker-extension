{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*",
    "*://twitter.com/*",
    "*://www.twitter.com/*",
    "*://mobile.twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitter Media Blocker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-all-blocking": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "__MSG_commandToggleAll__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://www.x.com/*",
        "*://twitter.com/*",
        "*://www.twitter.com/*",
        "*://mobile.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
