{
  "manifest_version": 3,
  "name": "Twitter Media Blocker",
  "version": "1.1.0",
  "description": "Hide or blur images and videos on X/Twitter. Block trending sidebar. Toggle with Alt+M.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitter Media Blocker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-all-blocking": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Toggle all media blocking on/off"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://www.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
